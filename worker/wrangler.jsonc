{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cv-twin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "ratelimits": [
    // Per visitor IP
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Across all visitors — caps Gemini spend
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-2.5-flash-lite",
    "ALLOWED_ORIGINS": "https://romanpu.github.io,http://localhost:3000"
  }
  // Secret (not in config): GEMINI_API_KEY — set with `wrangler secret put GEMINI_API_KEY`
}
